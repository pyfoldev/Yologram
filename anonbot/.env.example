# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Публичный HTTPS-адрес, по которому доступен веб-сервер бота (нужен для звонков)
BASE_URL=https://example.com
# Порт веб-сервера (звонки)
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Необязательно: TURN-сервер (скрывает IP собеседников, работает за NAT)
TURN_URL=
TURN_USER=
TURN_PASS=
# 1 = звонок только через TURN (IP собеседника не раскрывается). Нужен TURN_URL
FORCE_RELAY=0
