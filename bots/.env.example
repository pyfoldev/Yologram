# Скопируйте этот файл в .env и заполните значения.
# Токен выдаёт @BotFather (команда /newbot). Никогда не коммитьте .env!
BOT_TOKEN=123456:ABC-your-token

# Telegram ID администраторов через запятую (узнать свой ID: бот @userinfobot).
# Нужны ботам: 05 (анкета), 06 (поддержка), 07 (модератор), 09 (магазин).
ADMIN_IDS=111111111,222222222

# Только для бота 10 (ИИ-ассистент): ключ с https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
